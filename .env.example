# ==============================================================================
# Dots Platform — Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from Supabase Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Publishable anon key (safe for browser client)
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key (SERVER-SIDE ONLY — webhook / edge function backend, NEVER client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# Obtain from @BotFather on Telegram
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Custom secret token passed in X-Telegram-Bot-Api-Secret-Token header for webhook security
TELEGRAM_WEBHOOK_SECRET=your_custom_secure_secret_token_at_least_32_chars
